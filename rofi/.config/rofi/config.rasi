configuration{
    modi: "run,window,combi,notify:~/.config/rofi/rofi-dunst.sh";
    icon-theme: "Oranchelo";
    show-icons: true;
    terminal: "kitty";
    drun-display-format: "{icon} {name}";
    location: 0;
    disable-history: false;
    hide-scrollbar: true;
    display-combi: " 🖥️  All ";
    display-run: " 🏃  Run ";
    display-window: " 🪟  Window";
    display-notify: " 🪟  Notify";
    sidebar-mode: true;
}

@theme "theme"
